#pragma execution_character_set("utf-8")

#include <iostream>
#include <string>
#include <vector>
#include <algorithm>
#include <fstream>
#include <sstream>
#include <locale>

#ifdef _WIN32
#include <windows.h>
#endif

using namespace std;

class JaggedArray {
private:
    vector<vector<string>> a;

public:
    vector<string>& operator[](int i) {
        return a.at(i);
    }

    const vector<string>& operator[](int i) const {
        return a.at(i);
    }

    int size() const {
        return (int)a.size();
    }

    void add_endline(int k, const string& item) {
        if (k >= 0 && k < size())
            a[k].push_back(item);
        else
            cout << "Такой строки нет.\n";
    }

    void deleteItem(int i, int j) {
        if (i >= 0 && i < size() &&
            j >= 0 && j < (int)a[i].size()) {
            a[i].erase(a[i].begin() + j);
            cout << "Элемент удален.\n";
        }
        else {
            cout << "Неверные индексы.\n";
        }
    }

    void deleteItem(const string& item) {
        bool found = false;

        for (auto& row : a) {
            auto it = remove(row.begin(), row.end(), item);

            if (it != row.end()) {
                row.erase(it, row.end());
                found = true;
            }
        }

        if (found)
            cout << "Элементы удалены.\n";
        else
            cout << "Такого элемента нет.\n";
    }

    void sortRows() {
        for (auto& row : a)
            sort(row.begin(), row.end());

        cout << "Строки отсортированы.\n";
    }

    JaggedArray operator-(const JaggedArray& b) const {
        JaggedArray c = *this;

        for (auto& row : c.a) {
            vector<string> t;

            for (const auto& s : row) {
                if (find(t.begin(), t.end(), s) == t.end())
                    t.push_back(s);
            }

            row = t;
        }

        return c;
    }

    JaggedArray& operator--() {
        for (auto& row : a) {
            for (auto& s : row) {
                string t;

                for (unsigned char c : s) {
                    if (c < '0' || c > '9')
                        t += c;
                }

                s = t;
            }
        }

        return *this;
    }

    void print() const {
        const char* colors[] = {
            "\033[91m",
            "\033[92m",
            "\033[93m",
            "\033[94m",
            "\033[95m",
            "\033[96m"
        };

        for (int i = 0; i < size(); i++) {
            cout << colors[i % 6];
            cout << "Строка " << i << ": ";

            for (const auto& s : a[i])
                cout << "[" << s << "] ";

            cout << "\033[0m\n";
        }
    }

    bool load(const string& name) {
        ifstream f(name);

        if (!f.is_open())
            return false;

        a.clear();

        string s;

        while (getline(f, s)) {
            if (!s.empty() && s.back() == '\r')
                s.pop_back();

            vector<string> row;
            string item;
            stringstream ss(s);

            while (getline(ss, item, ',')) {
                row.push_back(item);
            }

            if (!s.empty() && s.back() == ',')
                row.push_back("");

            a.push_back(row);
        }

        return !f.bad();
    }
};

int main() {
#ifdef _WIN32
    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);

    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
    DWORD mode;

    if (GetConsoleMode(h, &mode))
        SetConsoleMode(h, mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING);
#endif

    setlocale(LC_ALL, "");

    JaggedArray a;

    if (!a.load("data.txt")) {
        cout << "Ошибка: не удалось прочитать data.txt.\n";
        cout << "Проверьте расположение файла.\n";
        return 1;
    }

    cout << "Данные успешно загружены из файла.\n";

    int n;

    do {
        cout << "\n===== ЗУБЧАТЫЙ МАССИВ =====\n";
        cout << "1. Вывести массив\n";
        cout << "2. Удалить элемент по индексам\n";
        cout << "3. Удалить элемент по значению\n";
        cout << "4. Добавить элемент в конец строки\n";
        cout << "5. Сортировать строки\n";
        cout << "6. Удалить дубликаты (оператор -)\n";
        cout << "7. Удалить цифры (оператор --)\n";
        cout << "0. Выход\n";
        cout << "Выберите пункт: ";

        if (!(cin >> n)) {
            cout << "Ошибка ввода.\n";
            break;
        }

        if (n == 1) {
            a.print();
        }
        else if (n == 2) {
            int i, j;

            cout << "Введите индекс строки и элемента: ";

            if (cin >> i >> j)
                a.deleteItem(i, j);
            else
                break;
        }
        else if (n == 3) {
            string s;

            cout << "Введите значение элемента: ";

            if (cin >> s)
                a.deleteItem(s);
            else
                break;
        }
        else if (n == 4) {
            int k;
            string s;

            cout << "Введите индекс строки: ";

            if (!(cin >> k))
                break;

            cout << "Введите новый элемент: ";

            if (!(cin >> s))
                break;

            a.add_endline(k, s);
        }
        else if (n == 5) {
            a.sortRows();
        }
        else if (n == 6) {
            a = a - a;
            cout << "Дубликаты удалены.\n";
        }
        else if (n == 7) {
            --a;
            cout << "Цифры удалены.\n";
        }
        else if (n != 0) {
            cout << "Такого пункта нет.\n";
        }

    } while (n != 0);

    cout << "Программа завершена.\n";

    return 0;
}
