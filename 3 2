using namespace std;

class JaggedArray {
private:
    vector<vector<string>> a;

    void removeEmptyEndRows() {
        while (!a.empty() && a.back().empty())
            a.pop_back();
    }

public:
    vector<string>& operator[](size_t i) {
        return a.at(i);
    }

    const vector<string>& operator[](size_t i) const {
        return a.at(i);
    }

    size_t size() const {
        return a.size();
    }

    void load(const string& filename) {
        ifstream f(filename, ios::binary);

        if (!f.is_open()) {
            cout << "Не удалось открыть файл: " << filename << '\n';
            return;
        }

        string line;
        bool first = true;

        while (getline(f, line)) {
            if (!line.empty() && line.back() == '\r')
                line.pop_back();

            if (first) {
                first = false;

                if (line.size() >= 3 &&
                    (unsigned char)line[0] == 0xEF &&
                    (unsigned char)line[1] == 0xBB &&
                    (unsigned char)line[2] == 0xBF)
                    line.erase(0, 3);
            }

            vector<string> row;
            string item;
            stringstream ss(line);

            while (getline(ss, item, ','))
                row.push_back(item);

            if (!line.empty() && line.back() == ',')
                row.push_back("");

            a.push_back(row);
        }
    }

    void print(const string& title) const {
        const string colors[] = {
            "\033[91m",
            "\033[92m",
            "\033[93m",
            "\033[94m",
            "\033[95m",
            "\033[96m"
        };

        cout << "\n\033[1m" << title << "\033[0m\n";

        if (a.empty()) {
            cout << "(массив пуст)\n";
            return;
        }

        for (size_t i = 0; i < a.size(); ++i) {
            cout << colors[i % 6]
                 << "Строка " << i << ": ";

            if (a[i].empty()) {
                cout << "(пустая)";
            } else {
                for (size_t j = 0; j < a[i].size(); ++j) {
                    if (j > 0)
                        cout << " | ";

                    cout << a[i][j];
                }
            }

            cout << "\033[0m\n";
        }
    }

    void deleteItem(size_t i, size_t j) {
        if (i >= a.size()) {
            cout << "Ошибка: строки с таким индексом нет.\n";
            return;
        }

        if (j >= a[i].size()) {
            cout << "Ошибка: элемента с таким индексом нет.\n";
            return;
        }

        cout << "Удалён элемент: " << a[i][j] << '\n';

        a[i].erase(a[i].begin() + j);
        removeEmptyEndRows();
    }

    void deleteItem(const string& item) {
        int count = 0;

        for (auto& row : a) {
            size_t oldSize = row.size();

            row.erase(
                remove(row.begin(), row.end(), item),
                row.end()
            );

            count += (int)(oldSize - row.size());
        }

        removeEmptyEndRows();

        cout << "Удалено элементов: " << count << '\n';
    }

    void add_endline(size_t k, const string& item) {
        while (a.size() <= k)
            a.push_back(vector<string>());

        a[k].push_back(item);

        cout << "Элемент добавлен.\n";
    }

    void sortRows() {
        for (auto& row : a)
            sort(row.begin(), row.end());

        cout << "Элементы в каждой строке отсортированы.\n";
    }

    JaggedArray operator-(const JaggedArray& b) const {
        JaggedArray result = *this;

        for (auto& row : result.a) {
            row.erase(
                remove_if(row.begin(), row.end(),
                    [&b](const string& item) {
                        for (const auto& otherRow : b.a) {
                            if (find(otherRow.begin(),
                                     otherRow.end(),
                                     item) != otherRow.end())
                                return true;
                        }

                        return false;
                    }),
                row.end()
            );
        }

        result.removeEmptyEndRows();
        return result;
    }

    void operator--() {
        for (auto& row : a) {
            for (auto& item : row) {
                item.erase(
                    remove_if(item.begin(), item.end(),
                        [](unsigned char c) {
                            return c >= '0' && c <= '9';
                        }),
                    item.end()
                );
            }
        }

        removeEmptyEndRows();
    }
};

