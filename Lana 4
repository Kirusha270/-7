// ============================================================
//  Работа с кодировками: всё внутри программы хранится в UTF-8
// ============================================================

static void appendUtf8(string& out, uint32_t cp) {
    if (cp < 0x80) {
        out += (char)cp;
    }
    else if (cp < 0x800) {
        out += (char)(0xC0 | (cp >> 6));
        out += (char)(0x80 | (cp & 0x3F));
    }
    else if (cp < 0x10000) {
        out += (char)(0xE0 | (cp >> 12));
        out += (char)(0x80 | ((cp >> 6) & 0x3F));
        out += (char)(0x80 | (cp & 0x3F));
    }
    else {
        out += (char)(0xF0 | (cp >> 18));
        out += (char)(0x80 | ((cp >> 12) & 0x3F));
        out += (char)(0x80 | ((cp >> 6) & 0x3F));
        out += (char)(0x80 | (cp & 0x3F));
    }
}

static bool isValidUtf8(const string& s) {
    size_t i = 0, n = s.size();

    while (i < n) {
        unsigned char c = (unsigned char)s[i];
        int len;

        if (c < 0x80) len = 1;
        else if ((c >> 5) == 0x6 && c >= 0xC2) len = 2;
        else if ((c >> 4) == 0xE) len = 3;
        else if ((c >> 3) == 0x1E && c <= 0xF4) len = 4;
        else return false;

        if (i + len > n)
            return false;

        for (int k = 1; k < len; k++) {
            if (((unsigned char)s[i + k] >> 6) != 0x2)
                return false;
        }

        i += len;
    }

    return true;
}

// Windows-1251 -> Unicode для байтов 0x80..0xBF
static const uint16_t CP1251_HIGH[64] = {
    0x0402, 0x0403, 0x201A, 0x0453, 0x201E, 0x2026, 0x2020, 0x2021,
    0x20AC, 0x2030, 0x0409, 0x2039, 0x040A, 0x040C, 0x040B, 0x040F,
    0x0452, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
    0x003F, 0x2122, 0x0459, 0x203A, 0x045A, 0x045C, 0x045B, 0x045F,
    0x00A0, 0x040E, 0x045E, 0x0408, 0x00A4, 0x0490, 0x00A6, 0x00A7,
    0x0401, 0x00A9, 0x0404, 0x00AB, 0x00AC, 0x00AD, 0x00AE, 0x0407,
    0x00B0, 0x00B1, 0x0406, 0x0456, 0x0491, 0x00B5, 0x00B6, 0x00B7,
    0x0451, 0x2116, 0x0454, 0x00BB, 0x0458, 0x0405, 0x0455, 0x0457
};

static string cp1251ToUtf8(const string& s) {
    string out;
    out.reserve(s.size() * 2);

    for (unsigned char c : s) {
        if (c < 0x80)
            appendUtf8(out, c);
        else if (c < 0xC0)
            appendUtf8(out, CP1251_HIGH[c - 0x80]);
        else
            appendUtf8(out, 0x0410 + (c - 0xC0)); // А..я
    }

    return out;
}

static string utf16ToUtf8(const string& s, size_t start, bool bigEndian) {
    string out;

    for (size_t i = start; i + 1 < s.size(); i += 2) {
        unsigned char b0 = (unsigned char)s[i];
        unsigned char b1 = (unsigned char)s[i + 1];
        uint32_t u = bigEndian ? ((b0 << 8) | b1) : ((b1 << 8) | b0);

        if (u >= 0xD800 && u <= 0xDBFF && i + 3 < s.size()) {
            unsigned char c0 = (unsigned char)s[i + 2];
            unsigned char c1 = (unsigned char)s[i + 3];
            uint32_t lo = bigEndian ? ((c0 << 8) | c1) : ((c1 << 8) | c0);

            if (lo >= 0xDC00 && lo <= 0xDFFF) {
                u = 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00);
                i += 2;
            }
        }

        appendUtf8(out, u);
    }

    return out;
}

// Читает файл и приводит его содержимое к UTF-8
// (UTF-8, UTF-8 с BOM, UTF-16 LE/BE, Windows-1251)
static bool readFileAsUtf8(const string& name, string& result) {
    ifstream f(name, ios::binary);

    if (!f.is_open())
        return false;

    string raw((istreambuf_iterator<char>(f)), istreambuf_iterator<char>());

    if (raw.size() >= 2 && (unsigned char)raw[0] == 0xFF && (unsigned char)raw[1] == 0xFE) {
        result = utf16ToUtf8(raw, 2, false);
    }
    else if (raw.size() >= 2 && (unsigned char)raw[0] == 0xFE && (unsigned char)raw[1] == 0xFF) {
        result = utf16ToUtf8(raw, 2, true);
    }
    else if (raw.size() >= 3 &&
        (unsigned char)raw[0] == 0xEF &&
        (unsigned char)raw[1] == 0xBB &&
        (unsigned char)raw[2] == 0xBF) {
        result = raw.substr(3);
    }
    else if (isValidUtf8(raw)) {
        result = raw;
    }
    else {
        result = cp1251ToUtf8(raw); // не UTF-8 -> считаем, что это Windows-1251
    }

    return true;
}

// Ввод строки из консоли в UTF-8 (в Windows через ReadConsoleW)
static bool readLine(string& out) {
#ifdef _WIN32
    HANDLE h = GetStdHandle(STD_INPUT_HANDLE);
    DWORD mode;

    if (GetConsoleMode(h, &mode)) {
        wstring w;
        wchar_t buf[512];
        DWORD got = 0;

        while (true) {
            if (!ReadConsoleW(h, buf, 512, &got, NULL) || got == 0)
                return false;

            w.append(buf, got);

            if (w.back() == L'\n')
                break;
        }

        while (!w.empty() && (w.back() == L'\n' || w.back() == L'\r'))
            w.pop_back();

        if (w.empty()) {
            out.clear();
            return true;
        }

        int len = WideCharToMultiByte(CP_UTF8, 0, w.c_str(), (int)w.size(), NULL, 0, NULL, NULL);
        out.assign(len, '\0');
        WideCharToMultiByte(CP_UTF8, 0, w.c_str(), (int)w.size(), &out[0], len, NULL, NULL);
        return true;
    }
#endif

    if (!getline(cin, out))
        return false;

    if (!out.empty() && out.back() == '\r')
        out.pop_back();

    return true;
}

static bool readInt(int& x) {
    string s;

    if (!readLine(s))
        return false;

    stringstream ss(s);
    return (bool)(ss >> x);
}

static string trim(const string& s) {
    size_t b = s.find_first_not_of(" \t");

    if (b == string::npos)
        return "";

    size_t e = s.find_last_not_of(" \t");
    return s.substr(b, e - b + 1);
}

// ============================================================
//  Зубчатый массив
// ============================================================

class JaggedArray {
private:
    vector<vector<string>> a;

public:
    vector<string>& operator[](int i) {
        return a.at(i);
    }

    const vector<string>& operator[](int i) const {
        return a.at(i);
    }

    int size() const {
        return (int)a.size();
    }

    void add_endline(int k, const string& item) {
        if (k >= 0 && k < size())
            a[k].push_back(item);
        else
            cout << "Такой строки нет.\n";
    }

    void deleteItem(int i, int j) {
        if (i >= 0 && i < size() &&
            j >= 0 && j < (int)a[i].size()) {
            a[i].erase(a[i].begin() + j);
            cout << "Элемент удален.\n";
        }
        else {
            cout << "Неверные индексы.\n";
        }
    }

    void deleteItem(const string& item) {
        bool found = false;

        for (auto& row : a) {
            auto it = remove(row.begin(), row.end(), item);

            if (it != row.end()) {
                row.erase(it, row.end());
                found = true;
            }
        }

        if (found)
            cout << "Элементы удалены.\n";
        else
            cout << "Такого элемента нет.\n";
    }

    void sortRows() {
        for (auto& row : a)
            sort(row.begin(), row.end());

        cout << "Строки отсортированы.\n";
    }

    JaggedArray operator-(const JaggedArray& b) const {
        JaggedArray c = *this;

        for (auto& row : c.a) {
            vector<string> t;

            for (const auto& s : row) {
                if (find(t.begin(), t.end(), s) == t.end())
                    t.push_back(s);
            }

            row = t;
        }

        return c;
    }

    JaggedArray& operator--() {
        for (auto& row : a) {
            for (auto& s : row) {
                string t;

                for (unsigned char c : s) {
                    if (c < '0' || c > '9')
                        t += (char)c;
                }

                s = t;
            }
        }

        return *this;
    }

    void print() const {
        const char* colors[] = {
            "\033[91m",
            "\033[92m",
            "\033[93m",
            "\033[94m",
            "\033[95m",
            "\033[96m"
        };

        for (int i = 0; i < size(); i++) {
            cout << colors[i % 6];
            cout << "Строка " << i << ": ";

            for (const auto& s : a[i])
                cout << "[" << s << "] ";

            cout << "\033[0m\n";
        }

        cout.flush();
    }

    bool load(const string& name) {
        string text;

        if (!readFileAsUtf8(name, text))
            return false;

        a.clear();

        stringstream in(text);
        string s;

        while (getline(in, s)) {
            if (!s.empty() && s.back() == '\r')
                s.pop_back();

            vector<string> row;
            string item;
            stringstream ss(s);

            while (getline(ss, item, ','))
                row.push_back(item);

            if (!s.empty() && s.back() == ',')
                row.push_back("");

            a.push_back(row);
        }

        return true;
    }
};

int main() {
#ifdef _WIN32
    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);

    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
    DWORD mode;

    if (GetConsoleMode(h, &mode))
        SetConsoleMode(h, mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING);
#endif

    // setlocale(LC_ALL, "") убран намеренно: он мог ломать вывод UTF-8

    JaggedArray a;

    if (!a.load("data.txt")) {
        cout << "Ошибка: не удалось прочитать data.txt.\n";
        cout << "Проверьте расположение файла.\n";
        return 1;
    }

    cout << "Данные успешно загружены из файла.\n";

    int n = -1;

    do {
        cout << "\n===== ЗУБЧАТЫЙ МАССИВ =====\n";
        cout << "1. Вывести массив\n";
        cout << "2. Удалить элемент по индексам\n";
        cout << "3. Удалить элемент по значению\n";
        cout << "4. Добавить элемент в конец строки\n";
        cout << "5. Сортировать строки\n";
        cout << "6. Удалить дубликаты (оператор -)\n";
        cout << "7. Удалить цифры (оператор --)\n";
        cout << "0. Выход\n";
        cout << "Выберите пункт: ";
        cout.flush();

        if (!readInt(n)) {
            cout << "Ошибка ввода.\n";
            break;
        }

        if (n == 1) {
            a.print();
        }
        else if (n == 2) {
            int i, j;

            cout << "Введите индекс строки: ";
            cout.flush();
            if (!readInt(i)) break;

            cout << "Введите индекс элемента: ";
            cout.flush();
            if (!readInt(j)) break;

            a.deleteItem(i, j);
        }
        else if (n == 3) {
            string s;

            cout << "Введите значение элемента: ";
            cout.flush();
            if (!readLine(s)) break;

            a.deleteItem(trim(s));
        }
        else if (n == 4) {
            int k;
            string s;

            cout << "Введите индекс строки: ";
            cout.flush();
            if (!readInt(k)) break;

            cout << "Введите новый элемент: ";
            cout.flush();
            if (!readLine(s)) break;

            a.add_endline(k, trim(s));
        }
        else if (n == 5) {
            a.sortRows();
        }
        else if (n == 6) {
            a = a - a;
            cout << "Дубликаты удалены.\n";
        }
        else if (n == 7) {
            --a;
            cout << "Цифры удалены.\n";
        }
        else if (n != 0) {
            cout << "Такого пункта нет.\n";
        }

    } while (n != 0);

    cout << "Программа завершена.\n";

    return 0;
}
