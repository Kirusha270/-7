#include <iostream>
#include <fstream>
#include <windows.h>

using namespace std;

// Проверка: русская гласная
int is_ru_vowel(unsigned char c)
{
    unsigned char vowels[] = {
        224, 229, 184, 232, 238, 243,
        250, 251, 252, 253, 254, 255
    }; // а е ё и о у ъ ы ь э ю я

    for (int i = 0; i < 12; i++)
        if (c == vowels[i])
            return 1;

    return 0;
}

// Проверка: английская гласная
int is_eng_vowel(char c)
{
    const char vowels[] = "aeiouy";

    for (int i = 0; vowels[i]; i++)
        if (c == vowels[i])
            return 1;

    return 0;
}

// Проверка: буква
int is_letter(unsigned char c)
{
    return
        (c >= 'A' && c <= 'Z') ||
        (c >= 'a' && c <= 'z') ||
        (c >= 192);
}

// Перевод в нижний регистр
unsigned char to_lower(unsigned char c)
{
    if (c >= 'A' && c <= 'Z')
        return c + 32;

    if (c >= 192 && c <= 223)
        return c + 32;

    if (c == 168)
        return 184;

    return c;
}

// Длина слова (без дефисов)
int word_length(const char* s)
{
    int len = 0;

    for (int i = 0; s[i]; i++)
    {
        if (s[i] != '-')
            len++;
    }

    return len;
}

// Проверка: содержит ли слово букву из запрещённого слова
int contains_forbidden(const char* word, const char* forbidden)
{
    for (int i = 0; word[i]; i++)
    {
        for (int j = 0; forbidden[j]; j++)
        {
            if (word[i] == forbidden[j])
                return 1;
        }
    }

    return 0;
}

// Копирование строки
void copy_string(char* dst, const char* src)
{
    int i;

    for (i = 0; src[i]; i++)
        dst[i] = src[i];

    dst[i] = '\0';
}

// Проверка уникальности
int is_unique(char words[][101], int count, const char* word)
{
    for (int i = 0; i < count; i++)
    {
        int same = 1;

        for (int j = 0; words[i][j] || word[j]; j++)
        {
            if (words[i][j] != word[j])
            {
                same = 0;
                break;
            }
        }

        if (same)
            return 0;
    }

    return 1;
}

