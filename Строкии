// ============================================================
//  Класс "Зубчатый массив" (jagged array) на основе
//  vector<vector<string>>
// ============================================================
class JaggedArray {
public:
    JaggedArray() = default;
    explicit JaggedArray(vector<vector<string>> d) : data_(move(d)) {}

    // ---- Переопределение обращения по индексам A[i][j] ----
    // operator[] класса отдаёт ссылку на строку (vector<string>&),
    // а второй индекс обрабатывается уже стандартным operator[]
    // вектора, поэтому синтаксис A[i][j] работает "из коробки".
    vector<string>& operator[](size_t i) { return data_.at(i); }
    const vector<string>& operator[](size_t i) const { return data_.at(i); }

    size_t rowCount() const { return data_.size(); }
    size_t colCount(size_t i) const { return data_.at(i).size(); }

    // ---- Удаление элемента по двойному индексу ----
    void deleteItem(size_t i, size_t j) {
        if (i >= data_.size()) {
            cerr << "Ошибка: строка " << i << " не существует.\n";
            return;
        }
        auto& row = data_[i];
        if (j >= row.size()) {
            cerr << "Ошибка: столбец " << j << " не существует в строке " << i << ".\n";
            return;
        }
        row.erase(row.begin() + (long)j);
    }

    // ---- Удаление элемента по значению (везде, где встречается) ----
    void deleteItem(const string& value) {
        for (auto& row : data_)
            row.erase(remove(row.begin(), row.end(), value), row.end());
    }

    // ---- Добавление элемента в конец строки k ----
    void add_endline(size_t k, const string& item) {
        if (k >= data_.size()) {
            cerr << "Ошибка: строка " << k << " не существует.\n";
            return;
        }
        data_[k].push_back(item);
    }

    // ---- Сортировка внутри каждой строки массива ----
    void sortRows() {
        for (auto& row : data_) sort(row.begin(), row.end());
    }

    // ---- Вывод массива в консоль: каждая строка своим цветом ----
    void print(const string& title = "") const {
        static const char* palette[] = {
            "\033[91m", "\033[92m", "\033[93m",
            "\033[94m", "\033[95m", "\033[96m"
        };
        const char* reset = "\033[0m";
        if (!title.empty()) cout << title << "\n";
        for (size_t i = 0; i < data_.size(); ++i) {
            const char* color = palette[i % 6];
            cout << color << "  [" << i << "] ";
            for (auto& v : data_[i]) cout << "\"" << v << "\" ";
            cout << reset << "\n";
        }
        cout << "\n";
    }

    // ---- operator- : построчное удаление дубликатов из массива ----
    // (унарный минус: -A возвращает новый массив, где в каждой строке
    //  оставлен только первый экземпляр повторяющегося элемента)
    JaggedArray operator-() const {
        JaggedArray result;
        result.data_.resize(data_.size());
        for (size_t i = 0; i < data_.size(); ++i) {
            vector<string> uniq;
            for (const auto& v : data_[i])
                if (find(uniq.begin(), uniq.end(), v) == uniq.end())
                    uniq.push_back(v);
            result.data_[i] = move(uniq);
        }
        return result;
    }

    // ---- operator-- : в каждом элементе убрать цифры ----
    // префиксная форма изменяет массив "на месте" и возвращает ссылку
    JaggedArray& operator--() {
        for (auto& row : data_)
            for (auto& v : row)
                v.erase(remove_if(v.begin(), v.end(),
                            [](unsigned char c) { return isdigit(c) != 0; }),
                        v.end());
        return *this;
    }
    // постфиксная форма возвращает копию состояния ДО изменения
    JaggedArray operator--(int) {
        JaggedArray old = *this;
        --(*this);
        return old;
    }

    // ---- Загрузка начальных значений из файла ----
    static JaggedArray loadFromJson(const string& filename);
    static JaggedArray loadFromCsv(const string& filename);
    static JaggedArray loadFromTxt(const string& filename);

private:
    vector<vector<string>> data_;
};

// ------------------------------------------------------------
// Разбор простого JSON вида [["a","b"],["c","d","e"], ...]
// (минимальный ручной парсер, без внешних зависимостей)
// ------------------------------------------------------------
JaggedArray JaggedArray::loadFromJson(const string& filename) {
    ifstream file(filename, ios::binary);
    if (!file) throw runtime_error("Не удалось открыть файл: " + filename);
    stringstream ss;
    ss << file.rdbuf();
    string text = ss.str();

    vector<vector<string>> result;
    size_t pos = 0, n = text.size();
    auto skipWs = [&]() { while (pos < n && isspace((unsigned char)text[pos])) ++pos; };

    skipWs();
    if (pos >= n || text[pos] != '[')
        throw runtime_error("Некорректный JSON: ожидался символ '['");
    ++pos;

    while (true) {
        skipWs();
        if (pos < n && text[pos] == ']') { ++pos; break; }
        if (pos >= n || text[pos] != '[')
            throw runtime_error("Некорректный JSON: ожидалась строка массива '['");
        ++pos;

        vector<string> row;
        while (true) {
            skipWs();
            if (pos < n && text[pos] == ']') { ++pos; break; }
            if (pos >= n || text[pos] != '"')
                throw runtime_error("Некорректный JSON: ожидалась строка в кавычках");
            ++pos;
            string value;
            while (pos < n && text[pos] != '"') {
                if (text[pos] == '\\' && pos + 1 < n) { value += text[pos + 1]; pos += 2; }
                else { value += text[pos]; ++pos; }
            }
            if (pos < n) ++pos; // закрывающая кавычка
            row.push_back(value);
            skipWs();
            if (pos < n && text[pos] == ',') { ++pos; continue; }
        }
        result.push_back(move(row));
        skipWs();
        if (pos < n && text[pos] == ',') { ++pos; continue; }
    }
    return JaggedArray(result);
}

// Каждая строка файла -> строка массива, значения через запятую
JaggedArray JaggedArray::loadFromCsv(const string& filename) {
    ifstream file(filename, ios::binary);
    if (!file) throw runtime_error("Не удалось открыть файл: " + filename);
    vector<vector<string>> result;
    string line;
    while (getline(file, line)) {
        if (!line.empty() && line.back() == '\r') line.pop_back();
        if (line.empty()) continue;
        vector<string> row;
        stringstream ls(line);
        string cell;
        while (getline(ls, cell, ',')) row.push_back(cell);
        result.push_back(move(row));
    }
    return JaggedArray(result);
}

// Каждая строка файла -> строка массива, значения через пробел
JaggedArray JaggedArray::loadFromTxt(const string& filename) {
    ifstream file(filename, ios::binary);
    if (!file) throw runtime_error("Не удалось открыть файл: " + filename);
    vector<vector<string>> result;
    string line;
    while (getline(file, line)) {
        if (!line.empty() && line.back() == '\r') line.pop_back();
        if (line.empty()) continue;
        vector<string> row;
        stringstream ls(line);
        string token;
        while (ls >> token) row.push_back(token);
        result.push_back(move(row));
    }
    return JaggedArray(result);
}

// ============================================================
//  Вспомогательные функции консоли (UTF-8, как в исходной лабе)
// ============================================================
static void setupConsole() {
#ifdef _WIN32
    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);
    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
    if (hOut != INVALID_HANDLE_VALUE) {
        DWORD mode = 0;
        if (GetConsoleMode(hOut, &mode))
            SetConsoleMode(hOut, mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING);
    }
#endif
}

// ============================================================
//  main: демонстрация всех операций зубчатого массива
// ============================================================
int main() {
    setupConsole();

    const string inputFile = "jagged_input.json";
    JaggedArray arr;

    try {
        arr = JaggedArray::loadFromJson(inputFile);
        cout << "Начальные значения загружены из файла \"" << inputFile << "\".\n\n";
    } catch (const exception& e) {
        cout << "Не удалось прочитать \"" << inputFile << "\" (" << e.what()
             << "), используются встроенные демонстрационные данные.\n\n";
        arr = JaggedArray(vector<vector<string>>{
            {"бета", "альфа", "гамма", "альфа", "дельта"},
            {"5", "42", "7", "42", "100"},
            {"я1", "б2б", "в3", "я1", "знак!"}
        });
    }

    arr.print("Исходный зубчатый массив:");

    // --- обращение по индексам A[i][j] ---
    cout << "Элемент A[0][1] = \"" << arr[0][1] << "\"\n\n";

    // --- delete(i, j) ---
    arr.deleteItem((size_t)0, (size_t)0);
    cout << "После deleteItem(0, 0):\n";
    arr.print();

    // --- delete(item) ---
    if (arr.rowCount() > 1 && !arr[1].empty()) {
        string victim = arr[1][0];
        arr.deleteItem(victim);
        cout << "После deleteItem(\"" << victim << "\") (удаление по значению):\n";
        arr.print();
    }

    // --- add_endline(k, item) ---
    arr.add_endline(0, "новый_элемент");
    cout << "После add_endline(0, \"новый_элемент\"):\n";
    arr.print();

    // --- сортировка внутри строк ---
    arr.sortRows();
    cout << "После сортировки внутри строк:\n";
    arr.print();

    // --- operator- : построчное удаление дубликатов ---
    JaggedArray deduped = -arr;
    cout << "Результат -arr (дубликаты в строках удалены):\n";
    deduped.print();

    // --- operator-- : убрать цифры из каждого элемента ---
    JaggedArray before = arr;         // сохраним копию "до"
    JaggedArray afterPrefix = --arr;  // префиксная форма меняет arr
    cout << "После --arr (цифры удалены из всех элементов):\n";
    arr.print();

    JaggedArray again = before;       // ещё одна копия "до"
    JaggedArray oldCopy = again--;    // постфиксная форма: oldCopy = состояние до изменения
    cout << "Постфиксная again-- : копия ДО изменения:\n";
    oldCopy.print();
    cout << "Постфиксная again-- : сам объект ПОСЛЕ изменения:\n";
    again.print();

    cout << "Нажмите Enter для выхода...";
    cin.get();
    return 0;
}

